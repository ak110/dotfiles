# shellcheck shell=bash
# shellcheck source=/dev/null

# Claude Codeのスナップショット自身が.bashrcを読む場合は、ログイン時に重ねて読まない。
# 起動スクリプトの形が変わった場合や通常のログインでは、以下の読込を保つ。
if [[ ${CLAUDECODE:-} == 1 && $- != *i* ]]; then
    case ${BASH_EXECUTION_STRING:-} in
    SNAPSHOT_FILE=*$'\n      source '"\"$HOME/.bashrc\" < /dev/null"$'\n'*) return 0 ;;
    esac
fi

# .bashrc
test -f ~/.bashrc && . ~/.bashrc

:
