# shellcheck shell=bash
# shellcheck source=/dev/null

# Claude Codeのスナップショット自身が.bashrcを読む場合は、ログイン時に重ねて読まない。
# 起動スクリプトの形が変わった場合や通常のログインでは、以下の読込を保つ。
if [[ ${CLAUDECODE:-} == 1 && $- != *i* ]]; then
    # 代入の直後に無条件で読む形だけを認識する。分岐などにあるsourceでは省かない。
    if [[ ${BASH_EXECUTION_STRING:-} =~ ^SNAPSHOT_FILE=[a-zA-Z0-9_./-]+$'\n'([[:blank:]]*$'\n')*[[:blank:]]*"source \"$HOME/.bashrc\" < /dev/null"$'\n' ]]; then
        return 0
    fi
fi

# .bashrc
test -f ~/.bashrc && . ~/.bashrc

:
