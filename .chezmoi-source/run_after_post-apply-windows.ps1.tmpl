Set-StrictMode -Version Latest
$ErrorActionPreference = 'Stop'

# dotfiles 後処理エントリポイント (Windows)。
# chezmoi apply 完了後に毎回実行する (run_after_* のため無条件実行)。
# 全ステップは冪等で、変更なしなら数秒で完了する。
#
# NOTE: 対応するLinux版 → run_after_post-apply.sh.tmpl
#
# 1. pytools を必要時に再導入する。
# 2. OS固有の後処理を完了する。
# 3. dotfiles-post-apply.exe を最終出力主体として実行する。

# update-dotfiles は本スクリプトの出力をパイプで受け取り UTF-8 として読む。
# 出力先がリダイレクトされている間、Windows PowerShell 5.1 は Write-Host とエラーの出力を
# コンソールのコードページ（日本語環境では CP932）で書くため、その間だけ UTF-8 へ切り替える。
# [Console]::OutputEncoding の設定はコンソール全体のコードページを変えるため、終了時に finally で元へ戻す。
# 本体は字下げせずに try の内側へ置く（テストが本体の区間を行頭の文字列で取り出すため）。
$originalOutputEncoding = [Console]::OutputEncoding
if ([Console]::IsOutputRedirected) {
    [Console]::OutputEncoding = New-Object System.Text.UTF8Encoding $false
}
try {

$cacheDir = Join-Path $env:LOCALAPPDATA 'dotfiles'
$hashFile = Join-Path $cacheDir 'pytools.hash'
$currentHash = '{{ include (joinPath .chezmoi.workingTree "pyproject.toml") | sha256sum }}:{{ include (joinPath .chezmoi.workingTree "agent-toolkit/pyproject.toml") | sha256sum }}'
$cachedHash = ''
if (Test-Path $hashFile) {
    $cachedHash = (Get-Content $hashFile -Encoding UTF8 -Raw)
}

# キャッシュ判定は「入力ハッシュ一致」と「期待シム実在」の両方を条件とする。
# プロジェクト定義のハッシュのみで判定すると、過去の uv tool install 部分失敗で
# シムが欠落したまま再インストールが永久にスキップされる事象が発生するため、
# post-apply 処理継続に必須のシムの実在もキャッシュキーへ組み込む。
$expectedShimDir = Join-Path $env:USERPROFILE '.local\bin'
# {{ $pyproject := include (joinPath .chezmoi.workingTree "pyproject.toml") | fromToml }}
$expectedShims = @(
# {{ range $name, $_ := $pyproject.project.scripts }}
    '{{ $name }}.exe'
# {{ end }}
)
function Test-ExpectedShims {
    foreach ($name in $expectedShims) {
        if (-not (Test-Path (Join-Path $expectedShimDir $name))) { return $false }
    }
    return $true
}
$needsReinstall = ($currentHash -ne $cachedHash) -or (-not (Test-ExpectedShims))

$mediaRemoteBin = Join-Path $env:USERPROFILE '.local\bin\dotfiles-media-remote.exe'
$escapedMediaRemoteBin = [System.Management.Automation.WildcardPattern]::Escape($mediaRemoteBin)
function Test-MediaRemoteProcess {
    param([object] $Process)
    if ($Process.ExecutablePath -and
        $Process.ExecutablePath.Equals($mediaRemoteBin, [System.StringComparison]::OrdinalIgnoreCase)) {
        return $true
    }
    if (-not $Process.CommandLine) { return $false }
    return ($Process.CommandLine -like "*$escapedMediaRemoteBin*") -or
        ($Process.CommandLine -like '*pytools.media_remote*')
}
function Get-PytoolsEnvLockingProcess {
    $prefix = $uvToolDir.TrimEnd('\') + '\'
    foreach ($process in Get-CimInstance Win32_Process -ErrorAction SilentlyContinue) {
        $isMediaRemote = Test-MediaRemoteProcess $process
        $isInToolEnv = $process.ExecutablePath -and
            $process.ExecutablePath.StartsWith($prefix, [System.StringComparison]::OrdinalIgnoreCase)
        if ($isInToolEnv -or $isMediaRemote) {
            $process | Select-Object *, @{Name = 'IsMediaRemote'; Expression = { $isMediaRemote } }
        }
    }
}
# uv tool venvの場所はOSと環境変数（UV_TOOL_DIR等）で変動する。
# `uv tool dir`の出力を一次情報源とし、取得失敗時はuvがWindowsで使う`%APPDATA%\uv\tools`へフォールバックする。
$uvToolBaseDir = $null
try {
    $uvToolBaseDir = (& uv tool dir 2>$null | Select-Object -First 1)
    # $ErrorActionPreference = 'Stop'はネイティブexeの非ゼロ終了を例外化しないため、
    # uv呼び出し直後で$LASTEXITCODEを明示判定し非ゼロなら$uvToolBaseDirを破棄する。
    if ($LASTEXITCODE -ne 0) { $uvToolBaseDir = $null }
    elseif ($uvToolBaseDir) { $uvToolBaseDir = $uvToolBaseDir.Trim() }
} catch {
    $uvToolBaseDir = $null
}
if (-not $uvToolBaseDir) {
    $uvToolBaseDir = Join-Path $env:APPDATA 'uv\tools'
}
$uvToolDir = Join-Path $uvToolBaseDir 'pytools'

# 再インストール時にuv tool venv配下のexeが起動中だと、uvはディレクトリ削除に
# アクセス拒否で失敗する。更新対象を保持するプロセスを停止前に分類し、
# 再起動できる既知プロセスだけなら停止・再導入する。再起動は post-apply が行う。
# post-apply は再導入の後に動くため、再導入の前の停止だけは本スクリプトで行う。
# 再起動できないプロセスが含まれる場合は一切停止せず、既存版とハッシュを温存して次回へ延期する。
$mediaRemoteWasRunning = $false
$reinstallDeferred = $false
$env:DOTFILES_PYTOOLS_INSTALL_STATE = ''
$env:DOTFILES_PYTOOLS_INSTALL_DETAIL = ''
if ($needsReinstall) {
    $lockingProcs = @(Get-PytoolsEnvLockingProcess)
    $restorableProcs = @()
    $unrestorableProcs = @()
    foreach ($p in $lockingProcs) {
        if ($p.IsMediaRemote) {
            $restorableProcs += $p
        } else {
            $unrestorableProcs += $p
        }
    }
    Write-Host "  [pytools] 更新対象の使用中プロセス: 候補$($lockingProcs.Count)件 再起動可$($restorableProcs.Count)件 再起動不可$($unrestorableProcs.Count)件"
    if ($unrestorableProcs.Count -gt 0) {
        $reinstallDeferred = $true
        $env:DOTFILES_PYTOOLS_INSTALL_STATE = 'deferred'
        $env:DOTFILES_PYTOOLS_INSTALL_DETAIL = ($unrestorableProcs | ForEach-Object { "$($_.Name) (PID=$($_.ProcessId))" }) -join ', '
        Write-Host '  [pytools] 再起動できないプロセスが更新対象を使用中 → 再インストールを次回へ延期'
    } else {
        foreach ($p in $restorableProcs) {
            $mediaRemoteWasRunning = $true
            Write-Host "  [pytools] $($p.Name) (PID=$($p.ProcessId)) を一時停止"
            Stop-Process -Id $p.ProcessId -Force -ErrorAction SilentlyContinue
        }
        if ($restorableProcs.Count -gt 0) {
            # プロセス停止からファイルハンドル解放までの遅延を吸収するため短時間待機する。
            Start-Sleep -Milliseconds 500
        }
    }
}

# post-apply 配下の出力は列 2 にインデントを揃える (詳細は pytools/post_apply.py 参照)。
if ($needsReinstall -and -not $reinstallDeferred) {
    if ($currentHash -ne $cachedHash) {
        Write-Host '  [pytools] Pythonプロジェクト定義に変更あり → 再インストール'
    } else {
        Write-Host '  [pytools] 期待シムが欠落 → 再インストール'
    }
    try {
        # $ErrorActionPreference = 'Stop' はネイティブ exe の非ゼロ終了を例外化しないため、
        # uv コマンド直後で $LASTEXITCODE を明示判定して throw する。
        # ハッシュ書き込みは uv tool install と期待シム実在再確認の両方が成功した場合のみ実行する。
        # ユーザーPATHへの`~\.local\bin`の登録は post-apply の「bin PATH 登録 (Windows)」工程が行う。
        & uv tool install --editable "{{ .chezmoi.workingTree }}" --with-editable "{{ joinPath .chezmoi.workingTree "agent-toolkit" }}"
        if ($LASTEXITCODE -ne 0) { throw "uv tool install が失敗しました (exit=$LASTEXITCODE)" }
        if (-not (Test-ExpectedShims)) {
            throw '期待シムが生成されていません'
        }
        if (-not (Test-Path $cacheDir)) {
            New-Item -ItemType Directory -Path $cacheDir -Force | Out-Null
        }
        Set-Content -Path $hashFile -Value $currentHash -Encoding UTF8 -NoNewline
    } catch {
        $env:DOTFILES_PYTOOLS_INSTALL_STATE = 'failed'
        $env:DOTFILES_PYTOOLS_INSTALL_DETAIL = $_.Exception.Message
        Write-Host "  [pytools] インストールに失敗しました (後続処理は継続): $_"
    }
} elseif ($reinstallDeferred) {
    Write-Host '  [pytools] 既存版で後続処理を継続'
} else {
    Write-Host '  [pytools] 変更なし (ハッシュキャッシュヒット)'
}

# 再導入のために media-remote を停止したかと再導入の要否を post-apply へ渡す。
# 再起動と、再導入しない回の停止→再起動（対症療法）は post-apply の「メディアリモコン自動起動」工程が行う。
$env:DOTFILES_MEDIA_REMOTE_STOPPED = if ($mediaRemoteWasRunning) { '1' } else { '' }
$env:DOTFILES_PYTOOLS_REINSTALL = if ($needsReinstall) { '1' } else { '' }

# `~\.local\bin` が現プロセスの PATH に無い場合があるため、フルパスで呼び出す。
# OS固有処理の後に実行し、post-applyの案内を更新処理全体の最終出力にする。
$postApplyBin = Join-Path $env:USERPROFILE '.local\bin\dotfiles-post-apply.exe'
if (Test-Path $postApplyBin) {
    # dotfiles-post-apply は chezmoi から独立した CLI のため、workingTree を環境変数で渡す
    $env:CHEZMOI_WORKING_TREE = '{{ .chezmoi.workingTree }}'
    & $postApplyBin
    exit $LASTEXITCODE
} else {
    Write-Host "  [pytools] $postApplyBin が見つからないため後処理スキップ"
}
} finally {
    [Console]::OutputEncoding = $originalOutputEncoding
}
