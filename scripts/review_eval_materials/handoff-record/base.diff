+import pathlib
+import tempfile
+import unittest
+
+from relay import record
+
+
+class RecordTest(unittest.TestCase):
+    def test_written_values_are_read_back(self) -> None:
+        with tempfile.TemporaryDirectory() as directory:
+            path = pathlib.Path(directory) / "handoff.json"
+            record.write(path, {"成果物": "/work/out.md"})
+            self.assertEqual(record.read(path), {"成果物": "/work/out.md"})
+
+    def test_empty_values_create_empty_record(self) -> None:
+        with tempfile.TemporaryDirectory() as directory:
+            path = pathlib.Path(directory) / "handoff.json"
+            record.write(path, {})
+            self.assertEqual(record.read(path), {})
+
+
+if __name__ == "__main__":
+    unittest.main()
