@@ -0,0 +1,16 @@
+"""引き継ぎ記録。前任が後任と委譲元へ渡す値を1つのJSONファイルへ書く。"""
+
+from __future__ import annotations
+
+import json
+import pathlib
+
+
+def write(path: pathlib.Path, values: dict[str, str]) -> None:
+    """引き継ぎ記録を書く。値が無い場合も空の記録を作る。"""
+    path.write_text(json.dumps(values, ensure_ascii=False, indent=1) + "\n", encoding="utf-8")
+
+
+def read(path: pathlib.Path) -> dict[str, str]:
+    """引き継ぎ記録の値を読む。"""
+    return json.loads(path.read_text(encoding="utf-8"))
