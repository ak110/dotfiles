+import pathlib
+import unittest
+
+from relay import prompt
+
+
+class PromptTest(unittest.TestCase):
+    def test_prompt_points_to_record_and_task(self) -> None:
+        text = prompt.compose("資料を直す", pathlib.Path("/work/handoff.json"))
+        self.assertIn("`/work/handoff.json`", text)
+        self.assertIn("依頼: 資料を直す", text)
+
+
+if __name__ == "__main__":
+    unittest.main()
