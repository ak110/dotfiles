+import pathlib
+import tempfile
+import unittest
+
+from relay import accept, record
+
+
+class AcceptTest(unittest.TestCase):
+    def test_missing_required_items_are_reported(self) -> None:
+        with tempfile.TemporaryDirectory() as directory:
+            path = pathlib.Path(directory) / "handoff.json"
+            record.write(path, {"成果物": "/work/out.md"})
+            result = accept.accept(path, required=("成果物", "計画"))
+        self.assertEqual(result["missing"], ["計画"])
+
+
+if __name__ == "__main__":
+    unittest.main()
