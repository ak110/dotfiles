+"""担当の交代で、後任へ渡す委譲プロンプトを組み立てる。"""
+
+from __future__ import annotations
+
+import pathlib
+
+
+def compose(task: str, record: pathlib.Path) -> str:
+    """依頼と引き継ぎ記録の所在から、後任の委譲プロンプトを返す。"""
+    return "\n".join(
+        [
+            f"最初に引き継ぎ記録`{record}`を読む。",
+            f"依頼: {task}",
+            "記録の値と依頼を比べ、残りの工程から再開する。",
+        ]
+    )
