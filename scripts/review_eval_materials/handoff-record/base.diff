+"""委譲元が、委譲先の終了後に引き継ぎ記録を検収する。"""
+
+from __future__ import annotations
+
+import pathlib
+
+from relay import record
+
+
+def accept(path: pathlib.Path, required: tuple[str, ...] = ()) -> dict[str, object]:
+    """記録の値と、役割が記録へ書くと定めた項目のうち欠けたものを返す。"""
+    values = record.read(path)
+    return {"values": values, "missing": [key for key in required if key not in values]}
