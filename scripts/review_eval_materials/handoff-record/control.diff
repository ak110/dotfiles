+def compose(task: str, path: pathlib.Path) -> str:
+    """依頼と引き継ぎ記録を読んだ結果から、後任の委譲プロンプトを返す。"""
+    observed = record.observe(path)
+    if observed.state == "read":
+        lines = [f"最初に引き継ぎ記録`{path}`を読む。", "記録の値と依頼を比べ、残りの工程から再開する。"]
+    elif observed.state == "absent":
+        lines = [
+            f"前任は引き継ぎ記録を作らなかった（`{path}`は存在しない）。",
+            "依頼と既存の原本（計画、commit、成果物）から残りの工程を確かめて再開する。",
         ]
-    )
+    else:
+        lines = [
+            f"引き継ぎ記録`{path}`を読めない（{observed.reason}）。",
+            "既存の原本から復元できる値で再開し、復元できない値は未確認として委譲元へ返す。",
+        ]
+    return "\n".join([lines[0], f"依頼: {task}", *lines[1:]])
diff --git a/relay/record.py b/relay/record.py
--- a/relay/record.py
+++ b/relay/record.py
@@ -2,15 +2,39 @@

 from __future__ import annotations

+import dataclasses
 import json
 import pathlib


 def write(path: pathlib.Path, values: dict[str, str]) -> None:
-    """引き継ぎ記録を書く。値が無い場合も空の記録を作る。"""
+    """引き継ぎ記録を書く。他の原本から復元できない値が無ければ、記録を作らない。"""
+    if not values:
+        return
     path.write_text(json.dumps(values, ensure_ascii=False, indent=1) + "\n", encoding="utf-8")


-def read(path: pathlib.Path) -> dict[str, str]:
-    """引き継ぎ記録の値を読む。"""
-    return json.loads(path.read_text(encoding="utf-8"))
+@dataclasses.dataclass(frozen=True)
+class Observation:
+    """記録を読んだ結果。`state`は`read`（読めた）、`absent`（不在を確かめた）、`unreadable`（それ以外で読めない）。"""
+
+    state: str
+    values: dict[str, str]
+    reason: str = ""
+
+
+def observe(path: pathlib.Path) -> Observation:
+    """記録を読み、読めた・不在・それ以外で読めないの3つに分けて返す。"""
+    try:
+        data = path.read_bytes()
+    except FileNotFoundError:
+        return Observation("absent", {})
+    except OSError as error:
+        return Observation("unreadable", {}, f"{type(error).__name__}: {error}")
+    try:
+        values = json.loads(data.decode("utf-8"))
+    except ValueError as error:
+        return Observation("unreadable", {}, f"本文を解釈できない: {error}")
+    if not isinstance(values, dict):
+        return Observation("unreadable", {}, "本文が値の対応表でない")
+    return Observation("read", values)
