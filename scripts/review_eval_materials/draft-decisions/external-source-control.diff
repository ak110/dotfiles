new file mode 100644
--- /dev/null
+++ b/src/service.py
@@ -0,0 +1,9 @@
+def read(fetch, clock, max_attempts):
+    for attempt in range(max_attempts):
+        try:
+            return fetch()
+        except TimeoutError:
+            if attempt + 1 == max_attempts:
+                raise
+            clock.sleep(1)
+    raise ValueError("positive max_attempts required")
