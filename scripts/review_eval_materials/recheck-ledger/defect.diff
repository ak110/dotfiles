+def recheck(path: pathlib.Path, round_: int, row_id: int, verdict: str, residual: int | None = None) -> None:
+    """前回の指摘へ判定を追記する。
+
+    対応不十分・未対応は、今回のroundに「前回から残存」として登録した行を`residual`で指す。
+    判定は追記だけで、同じ指摘の以前の判定は消さない。
+    """
+    rows = load(path)
+    latest = current_round(rows)
+    if round_ < 2 or round_ < latest:
+        raise ValueError(f"roundは2以上で、記録済みの最大のround（{latest}）以上の整数")
+    target = _find(rows, row_id)
+    if target["round"] >= round_:
+        raise ValueError(f"行{row_id}はround {round_}より前の指摘でない")
+    if not target["response"]:
+        raise ValueError(f"行{row_id}には応答が無い")
+    if verdict not in VERDICTS:
+        raise ValueError(f"判定は{'・'.join(VERDICTS)}のいずれか")
+    if verdict in _UNRESOLVED:
+        if residual is None:
+            raise ValueError("対応不十分・未対応には、指摘の残りを登録した行（residual）が必要")
+        rest = _find(rows, residual)
+        if rest["round"] != round_ or rest.get("category") != "前回から残存":
+            raise ValueError(f"行{residual}はround {round_}の「前回から残存」の指摘でない")
+    elif residual is not None:
+        raise ValueError("完了にはresidualを指定しない")
+    target.setdefault("checks", []).append({"round": round_, "verdict": verdict, "residual": residual})
+    _save(path, rows)
+
+
+def _latest_check(row: dict, round_: int) -> dict | None:
+    checks = sorted((check for check in row.get("checks", []) if check["round"] <= round_), key=lambda check: check["round"])
+    return checks[-1] if checks else None
+
+
 def summary(path: pathlib.Path, round_: int) -> dict:
-    """指定したroundの指摘の件数と、応答の無い件数を返す。"""
-    current = [row for row in load(path) if row["round"] == round_]
-    return {"findings": len(current), "unanswered": sum(1 for row in current if not row["response"])}
+    """指定したroundの集計を返す。
+
+    `unanswered`はこのroundの指摘のうち応答の無い件数である。
+    `recheck_pending`はこのroundより前の指摘のうち、このround以前の判定が1つも無い件数である。
+    `verdicts`はこのroundより前の指摘ごとの、このround以前で最も新しい判定の件数である。
+    `converged`は、このroundに指摘が無く、`recheck_pending`が0であることを表す。
+    """
+    rows = load(path)
+    current = [row for row in rows if row["round"] == round_]
+    verdicts = dict.fromkeys(VERDICTS, 0)
+    pending = 0
+    for row in (row for row in rows if row["round"] < round_):
+        check = _latest_check(row, round_)
+        if check is None:
+            pending += 1
+        else:
+            verdicts[check["verdict"]] += 1
+    return {
+        "findings": len(current),
+        "unanswered": sum(1 for row in current if not row["response"]),
+        "recheck_pending": pending,
+        "verdicts": verdicts,
+        "converged": not current and pending == 0,
+    }
