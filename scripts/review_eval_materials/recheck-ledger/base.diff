+import contextlib
+import io
+import json
+import pathlib
+import tempfile
+import unittest
+
+from ledger import cli
+
+
+class CliTest(unittest.TestCase):
+    def test_add_respond_and_summary(self) -> None:
+        with tempfile.TemporaryDirectory() as directory:
+            table = str(pathlib.Path(directory) / "review.json")
+            output = io.StringIO()
+            with contextlib.redirect_stdout(output):
+                self.assertEqual(cli.main(["--table", table, "add", "--round", "1", "--issue", "集計が失敗する"]), 0)
+                self.assertEqual(cli.main(["--table", table, "respond", "--row-id", "1", "--text", "直した"]), 0)
+                self.assertEqual(cli.main(["--table", table, "summary", "--round", "1"]), 0)
+        self.assertEqual(json.loads(output.getvalue().splitlines()[-1]), {"findings": 1, "unanswered": 0})
+
+
+if __name__ == "__main__":
+    unittest.main()
