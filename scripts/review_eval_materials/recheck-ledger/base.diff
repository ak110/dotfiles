+"""管理表を操作するCLI。"""
+
+from __future__ import annotations
+
+import argparse
+import json
+import pathlib
+import sys
+
+from ledger import store
+
+_ADD_MANY_EPILOG = """\
+--items-fileには、指摘を次の形のJSON配列で書く。
+  [{"round": 1, "issue": "集計が空の表で失敗する"}]
+"""
+
+
+def build_parser() -> argparse.ArgumentParser:
+    parser = argparse.ArgumentParser(prog="ledger", description="レビュー指摘の管理表を操作する。")
+    parser.add_argument("--table", type=pathlib.Path, default=pathlib.Path("review.json"), help="管理表のパス")
+    sub = parser.add_subparsers(dest="command", required=True)
+    add = sub.add_parser("add", help="指摘を1行追加する")
+    add.add_argument("--round", type=int, required=True, help="レビューのround")
+    add.add_argument("--issue", required=True, help="指摘の本文")
+    add_many = sub.add_parser(
+        "add-many",
+        help="指摘をまとめて追加する",
+        epilog=_ADD_MANY_EPILOG,
+        formatter_class=argparse.RawDescriptionHelpFormatter,
+    )
+    add_many.add_argument("--items-file", type=pathlib.Path, required=True, help="指摘のJSON配列のファイル")
+    respond = sub.add_parser("respond", help="指摘の行へ応答を書く")
+    respond.add_argument("--row-id", type=int, required=True, help="行の識別子")
+    respond.add_argument("--text", required=True, help="応答の本文")
+    respond_many = sub.add_parser("respond-many", help="応答をまとめて書く")
+    respond_many.add_argument("--items-file", type=pathlib.Path, required=True, help="応答のJSON配列のファイル")
+    summary = sub.add_parser("summary", help="roundの集計を出す")
+    summary.add_argument("--round", type=int, required=True, help="集計するround")
+    return parser
+
+
+def _items(path: pathlib.Path) -> list[dict]:
+    return json.loads(path.read_text(encoding="utf-8"))
+
+
+def main(argv: list[str] | None = None) -> int:
+    args = build_parser().parse_args(argv)
+    try:
+        if args.command == "add":
+            print(store.add(args.table, args.round, args.issue))
+        elif args.command == "add-many":
+            for row_id in store.add_many(args.table, _items(args.items_file)):
+                print(row_id)
+        elif args.command == "respond":
+            store.respond(args.table, args.row_id, args.text)
+        elif args.command == "respond-many":
+            store.respond_many(args.table, _items(args.items_file))
+        else:
+            print(json.dumps(store.summary(args.table, args.round), ensure_ascii=False))
+    except (KeyError, ValueError) as error:
+        print(f"失敗: {error}", file=sys.stderr)
+        return 1
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
