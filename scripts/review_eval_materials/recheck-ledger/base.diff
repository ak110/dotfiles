@@ -0,0 +1,77 @@
+"""レビュー指摘の管理表。1つのJSONファイルへ指摘の行を配列で記録する。"""
+
+from __future__ import annotations
+
+import json
+import pathlib
+
+
+def load(path: pathlib.Path) -> list[dict]:
+    """管理表の行を読む。ファイルが無ければ空の表として扱う。"""
+    if not path.exists():
+        return []
+    return json.loads(path.read_text(encoding="utf-8"))
+
+
+def _save(path: pathlib.Path, rows: list[dict]) -> None:
+    path.write_text(json.dumps(rows, ensure_ascii=False, indent=1) + "\n", encoding="utf-8")
+
+
+def _row(row_id: int, round_: int, issue: str, response: str) -> dict:
+    return {"id": row_id, "round": round_, "issue": issue, "response": response}
+
+
+def _find(rows: list[dict], row_id: int) -> dict:
+    if not 1 <= row_id <= len(rows):
+        raise ValueError(f"行{row_id}は無い")
+    return rows[row_id - 1]
+
+
+def _validate(round_: int, issue: str) -> None:
+    if round_ < 1:
+        raise ValueError("roundは1以上の整数")
+    if not issue.strip():
+        raise ValueError("指摘の本文が空")
+
+
+def add(path: pathlib.Path, round_: int, issue: str) -> int:
+    """指摘を1行追加し、行の識別子を返す。"""
+    return add_many(path, [{"round": round_, "issue": issue}])[0]
+
+
+def add_many(path: pathlib.Path, items: list[dict]) -> list[int]:
+    """指摘をまとめて追加し、行の識別子を返す。itemsは{"round": round, "issue": 本文}の配列で、1件でも不正なら表を変えない。"""
+    rows = load(path)
+    added = []
+    for item in items:
+        _validate(item["round"], item["issue"])
+        rows.append(_row(len(rows) + 1, item["round"], item["issue"], ""))
+        added.append(len(rows))
+    _save(path, rows)
+    return added
+
+
+def respond(path: pathlib.Path, row_id: int, text: str) -> None:
+    """指摘の行へレビューイーの応答を書く。書き直しは前の応答を置き換える。"""
+    if not text.strip():
+        raise ValueError("応答の本文が空")
+    rows = load(path)
+    _find(rows, row_id)["response"] = text
+    _save(path, rows)
+
+
+def respond_many(path: pathlib.Path, items: list[dict]) -> None:
+    """複数の行へ応答を書く。itemsは{"id": 行の識別子, "response": 応答の本文}の配列。"""
+    rows = load(path)
+    for item in items:
+        row = _find(rows, item["id"])
+        if not item["response"].strip():
+            raise ValueError(f"行{item['id']}の応答の本文が空")
+        rows[row["id"] - 1] = _row(row["id"], row["round"], row["issue"], item["response"])
+    _save(path, rows)
+
+
+def summary(path: pathlib.Path, round_: int) -> dict:
+    """指定したroundの指摘の件数と、応答の無い件数を返す。"""
+    current = [row for row in load(path) if row["round"] == round_]
+    return {"findings": len(current), "unanswered": sum(1 for row in current if not row["response"])}
