+"""全てのサブコマンドについて、ヘルプの表示と必須引数の受理を確かめる横断試験。"""
+
+import argparse
+import contextlib
+import io
+import unittest
+
+from ledger import cli
+
+
+def _subparsers() -> dict[str, argparse.ArgumentParser]:
+    parser = cli.build_parser()
+    action = next(item for item in parser._actions if isinstance(item, argparse._SubParsersAction))
+    return dict(action.choices)
+
+
+def _sample(action: argparse.Action) -> str:
+    if action.choices:
+        return str(next(iter(action.choices)))
+    return "1" if action.type in (int, float) else "value"
+
+
+class HelpTest(unittest.TestCase):
+    def test_every_subcommand_shows_help(self) -> None:
+        for name in _subparsers():
+            with self.subTest(name), contextlib.redirect_stdout(io.StringIO()):
+                with self.assertRaises(SystemExit) as raised:
+                    cli.build_parser().parse_args([name, "--help"])
+                self.assertEqual(raised.exception.code, 0)
+
+    def test_every_subcommand_accepts_sample_required_arguments(self) -> None:
+        for name, child in _subparsers().items():
+            arguments = [name]
+            for action in child._actions:
+                if action.required and action.option_strings:
+                    arguments += [action.option_strings[0], _sample(action)]
+            with self.subTest(name), contextlib.redirect_stderr(io.StringIO()):
+                cli.build_parser().parse_args(arguments)
+
+
+if __name__ == "__main__":
+    unittest.main()
