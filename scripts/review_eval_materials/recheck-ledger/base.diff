+import pathlib
+import tempfile
+import unittest
+
+from ledger import store
+
+
+class StoreTest(unittest.TestCase):
+    def setUp(self) -> None:
+        self._directory = tempfile.TemporaryDirectory()
+        self.table = pathlib.Path(self._directory.name) / "review.json"
+
+    def tearDown(self) -> None:
+        self._directory.cleanup()
+
+    def test_summary_counts_unanswered_findings_of_round(self) -> None:
+        store.add(self.table, 1, "集計が空の表で失敗する")
+        store.add(self.table, 1, "ヘルプの例が古い")
+        store.respond(self.table, 1, "空の表を0件として扱った")
+        self.assertEqual(store.summary(self.table, 1), {"findings": 2, "unanswered": 1})
+
+    def test_respond_many_writes_each_response(self) -> None:
+        store.add(self.table, 1, "集計が空の表で失敗する")
+        store.add(self.table, 1, "ヘルプの例が古い")
+        store.respond_many(self.table, [{"id": 1, "response": "直した"}, {"id": 2, "response": "例を直した"}])
+        self.assertEqual([row["response"] for row in store.load(self.table)], ["直した", "例を直した"])
+
+    def test_empty_issue_is_rejected(self) -> None:
+        with self.assertRaises(ValueError):
+            store.add(self.table, 1, " ")
+
+
+if __name__ == "__main__":
+    unittest.main()
