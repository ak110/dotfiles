+def recheck(path: pathlib.Path, round_: int, row_id: int, verdict: str, rest: str | None = None) -> int | None:
+    """前回の指摘へ判定を追記する。
+
+    対応不十分・未対応は、指摘の残りの本文`rest`を今回のroundの「前回から残存」の行として登録し、その行の識別子を返す。
+    登録した行は判定した指摘を`origin`で指すため、別の指摘の残りを指すことは無い。
+    判定は1つのroundに1回だけ追記し、以前の判定は消さない。誤った判定は次のroundの判定で改める。
+    """
+    rows = load(path)
+    if round_ < 2:
+        raise ValueError("roundは2以上の整数")
+    _require_current(rows, round_)
+    target = _find(rows, row_id)
+    if target["round"] >= round_:
+        raise ValueError(f"行{row_id}はround {round_}より前の指摘でない")
+    if not target["response"]:
+        raise ValueError(f"行{row_id}には応答が無い")
+    if verdict not in VERDICTS:
+        raise ValueError(f"判定は{'・'.join(VERDICTS)}のいずれか")
+    if any(check["round"] == round_ for check in target.get("checks", [])):
+        raise ValueError(f"行{row_id}にはround {round_}の判定が既にある。改める場合は次のroundで判定する")
+    residual = None
+    if verdict in _UNRESOLVED:
+        if rest is None or not rest.strip():
+            raise ValueError("対応不十分・未対応には、指摘の残りの本文（rest）が必要")
+        rows.append(_row(len(rows) + 1, round_, rest, _RESIDUAL, origin=row_id))
+        residual = len(rows)
+    elif rest is not None:
+        raise ValueError("完了にはrestを指定しない")
+    target.setdefault("checks", []).append({"round": round_, "verdict": verdict, "residual": residual})
+    _save(path, rows)
+    return residual
+
+
+def _latest_check(row: dict, round_: int) -> dict | None:
+    checks = [check for check in row.get("checks", []) if check["round"] <= round_]
+    return max(checks, key=lambda check: check["round"]) if checks else None
+
+
