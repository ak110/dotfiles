-    return {"findings": len(current), "unanswered": sum(1 for row in current if not row["response"])}
+    """指定したroundの集計を返す。
+
+    `unanswered`はこのroundの指摘のうち応答の無い件数である。
+    `recheck_pending`はこのroundより前の指摘のうち、このround以前の判定が1つも無い件数である。
+    `verdicts`はこのroundより前の指摘ごとの、このround以前で最も新しい判定の件数である。
+    `converged`は、このroundに指摘が無く、`recheck_pending`が0であることを表す。
+    """
+    rows = load(path)
+    current = [row for row in rows if row["round"] == round_]
+    verdicts = dict.fromkeys(VERDICTS, 0)
+    pending = 0
+    for row in (row for row in rows if row["round"] < round_):
+        check = _latest_check(row, round_)
+        if check is None:
+            pending += 1
+        else:
+            verdicts[check["verdict"]] += 1
+    return {
+        "findings": len(current),
+        "unanswered": sum(1 for row in current if not row["response"]),
+        "recheck_pending": pending,
+        "verdicts": verdicts,
+        "converged": not current and pending == 0,
+    }
