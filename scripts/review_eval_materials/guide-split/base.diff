+++ b/tests/cli_list_test.py
@@ -0,0 +1,20 @@
+import contextlib
+import io
+import unittest
+
+from guidekit import catalog, cli
+
+
+class CliListTest(unittest.TestCase):
+    def test_list_shows_every_registered_guide_and_heading(self) -> None:
+        output = io.StringIO()
+        with contextlib.redirect_stdout(output):
+            self.assertEqual(cli.main(["list"]), 0)
+        lines = output.getvalue().splitlines()
+        self.assertEqual(len(lines), len(catalog.GUIDES))
+        for name, line in zip(catalog.GUIDES, lines):
+            self.assertEqual(line, f"{name}: {', '.join(catalog.sections(name))}")
+
+
+if __name__ == "__main__":
+    unittest.main()
diff --git a/tests/usage_links_test.py b/tests/usage_links_test.py
new file mode 100644
--- /dev/null
+++ b/tests/usage_links_test.py
@@ -0,0 +1,21 @@
+import pathlib
+import re
+import unittest
+
+ROOT = pathlib.Path(__file__).resolve().parent.parent
+_REFERENCE = re.compile(r"`(guides/[^`]+\.md)`「([^」]+)」")
+
+
+class UsageLinksTest(unittest.TestCase):
+    def test_every_reference_points_to_existing_heading(self) -> None:
+        text = (ROOT / "docs/usage.md").read_text(encoding="utf-8")
+        references = _REFERENCE.findall(text)
+        self.assertTrue(references)
+        for path, heading in references:
+            with self.subTest(path=path, heading=heading):
+                lines = (ROOT / path).read_text(encoding="utf-8").splitlines()
+                self.assertIn(f"## {heading}", lines)
+
+
+if __name__ == "__main__":
+    unittest.main()
