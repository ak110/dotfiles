+"""文章の基準の資料を名前と見出しで引く。"""
+
+from __future__ import annotations
+
+import pathlib
+
+ROOT = pathlib.Path(__file__).resolve().parent.parent / "guides"
+GUIDES = ("writing",)
+
+
+def path(name: str) -> pathlib.Path:
+    """資料の名前からファイルのパスを返す。"""
+    if name not in GUIDES:
+        raise KeyError(f"資料{name}は登録されていない")
+    return ROOT / f"{name}.md"
+
+
+def sections(name: str) -> list[str]:
+    """資料のH2見出しを記載順に返す。"""
+    lines = path(name).read_text(encoding="utf-8").splitlines()
+    return [line.removeprefix("## ").strip() for line in lines if line.startswith("## ")]
+
+
+def find(heading: str) -> str:
+    """見出しを持つ資料の名前を返す。"""
+    for name in GUIDES:
+        if heading in sections(name):
+            return name
+    raise KeyError(f"見出し{heading}を持つ資料は無い")
