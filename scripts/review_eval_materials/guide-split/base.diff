@@ -0,0 +1,39 @@
+"""資料の一覧と見出しの検索を行うCLI。"""
+
+from __future__ import annotations
+
+import argparse
+import sys
+
+from guidekit import catalog
+
+
+def build_parser() -> argparse.ArgumentParser:
+    parser = argparse.ArgumentParser(prog="guidekit", description="文章の基準の資料を引く。")
+    sub = parser.add_subparsers(dest="command", required=True)
+    sub.add_parser("list", help="登録した資料と見出しを一覧する")
+    show = sub.add_parser("show", help="資料の本文を出す")
+    show.add_argument("name")
+    find = sub.add_parser("find", help="見出しを持つ資料の名前を出す")
+    find.add_argument("heading")
+    return parser
+
+
+def main(argv: list[str] | None = None) -> int:
+    args = build_parser().parse_args(argv)
+    try:
+        if args.command == "list":
+            for name in catalog.GUIDES:
+                print(f"{name}: {', '.join(catalog.sections(name))}")
+        elif args.command == "show":
+            print(catalog.path(args.name).read_text(encoding="utf-8"), end="")
+        else:
+            print(catalog.find(args.heading))
+    except KeyError as error:
+        print(f"失敗: {error.args[0]}", file=sys.stderr)
+        return 1
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
