+import unittest
+
+from guidekit import catalog
+
+
+class CatalogTest(unittest.TestCase):
+    def test_sections_follow_document_order(self) -> None:
+        self.assertEqual(catalog.sections("writing"), ["共通", "業務文書", "調査報告"])
+
+    def test_find_returns_guide_with_heading(self) -> None:
+        self.assertEqual(catalog.find("調査報告"), "writing")
+
+    def test_unknown_guide_is_rejected(self) -> None:
+        with self.assertRaises(KeyError):
+            catalog.path("missing")
+
+
+if __name__ == "__main__":
+    unittest.main()
diff --git a/tests/cli_list_test.py b/tests/cli_list_test.py
