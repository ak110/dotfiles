#!/usr/bin/env bash
set -euo pipefail

flag="$HOME/.config/dotfiles/tmux-auto-attach"

usage() {
    cat <<'EOF' >&2
使い方: autotmux <on|off|status>

SSH対話ログイン時のtmux自動アタッチをホスト単位で切り替えます。
有効化フラグは ~/.config/dotfiles/tmux-auto-attach に作成されます。
EOF
}

case "${1:-}" in
on)
    mkdir -p "$(dirname "$flag")"
    : >"$flag"
    echo "autotmux: on (${flag})。次回のSSH対話ログインからtmuxへ自動アタッチします。無効化: autotmux off"
    ;;
off)
    rm -f "$flag"
    echo "autotmux: off。次回のSSH対話ログインから自動アタッチしません。有効化: autotmux on"
    ;;
status)
    if [ -e "$flag" ]; then
        echo "autotmux: on (${flag})。無効化: autotmux off"
        exit 0
    else
        echo "autotmux: off。有効化: autotmux on（次回のSSH対話ログインから有効）"
        exit 1
    fi
    ;;
*)
    usage
    exit 2
    ;;
esac
