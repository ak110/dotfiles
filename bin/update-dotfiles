#!/usr/bin/env bash
set -euo pipefail
# dotfiles を最新化する。実体は libexec/update_dotfiles.py（PEP 723）。
# NOTE: 対応するWindows版 → bin/update-dotfiles.cmd
SELF="$(readlink -f "${BASH_SOURCE[0]}")"
SCRIPT_DIR="$(cd "$(dirname "${SELF}")/.." && pwd)"
UV="$HOME/.local/bin/uv"
if [[ ! -x "$UV" ]]; then
    echo "uvが見つかりません。次の操作: https://docs.astral.sh/uv/getting-started/installation/ の公式手順でuvを導入し、update-dotfilesを再実行してください。" >&2
    exit 127
fi
self_update_failed=0
if [[ "${1:-}" != "logs" && "${AGENT_TOOLKIT_PROCESS_LOOP_SESSION:-}" != "1" ]]; then
    "$UV" self update || self_update_failed=1
fi
run_exit=0
# 更新中にランチャーが置換されても、解析済みの終了処理を実行する。
{
    "$UV" run --no-project --script "${SCRIPT_DIR}/libexec/update_dotfiles.py" "$@" || run_exit=$?
    if ((self_update_failed != 0)); then
        echo "uvの自己更新に失敗しました。既存のuvでdotfiles更新を実行し、次回のupdate-dotfiles起動時に自己更新を再試行します。対応不要（dotfilesの更新処理は継続しました）。" >&2
    fi
    exit "$run_exit"
}
