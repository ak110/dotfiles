#!/usr/bin/env bash
set -euo pipefail
# dotfiles を最新化する。実体は scripts/update_dotfiles.py（PEP 723）。
# NOTE: 対応するWindows版 → bin/update-dotfiles.cmd
SELF="$(readlink -f "${BASH_SOURCE[0]}")"
SCRIPT_DIR="$(cd "$(dirname "${SELF}")/.." && pwd)"
exec uv run --no-project --script "${SCRIPT_DIR}/scripts/update_dotfiles.py" "$@"
