{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "requiredMinimumVersion": "2.1.205",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \"__HOME__\\dotfiles\\scripts\\claude-hook-pretooluse.ps1\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Skill|Read",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -Command \"& { uv run --no-project --script '__HOME__\\dotfiles\\scripts\\claude_hook.py' posttooluse; exit 0 }\""
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "__HOME__/.local/bin/claude-statusline.exe statusline",
    "padding": 0
  },
  "subagentStatusLine": {
    "type": "command",
    "command": "__HOME__/.local/bin/claude-statusline.exe subagent-statusline"
  }
}
