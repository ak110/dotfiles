# Win/Linux共用のユーザー環境変数
#
# Linuxでは ~/.bashrc が set -a の下でこのファイルを読み込み、
# Windowsではpost-applyの「user.env 環境変数 (Windows)」工程がユーザー環境変数へ書き込む。
# 両者が同じ値を得るよう、有効な行は KEY=VALUE の形だけで書く。
# 値には引用符・$による展開・空白・行末コメントを使わず、行頭へ export を付けない。
# コメントは行頭を # にした行だけで書く。

# Python
PYTHONDONTWRITEBYTECODE=1

# Claude Code
# ANTHROPIC_CUSTOM_HEADERS='User-Agent: claude-cli/2.1.98 (external, sdk-cli)'
