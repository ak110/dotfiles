{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "requiredMinimumVersion": "2.1.205",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "sh -c 'uv run --no-project --script ~/dotfiles/scripts/claude_hook.py pretooluse; code=$?; [ $code -eq 2 ] && exit 2 || exit 0'"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Skill|Read",
        "hooks": [
          {
            "type": "command",
            "command": "sh -c 'uv run --no-project --script ~/dotfiles/scripts/claude_hook.py posttooluse; exit 0'"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh -c 'uv run --no-project --script ~/dotfiles/scripts/claude_hook.py autonomous_exit; exit 0'"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "__HOME__/.local/bin/claude-statusline statusline",
    "padding": 0
  },
  "subagentStatusLine": {
    "type": "command",
    "command": "__HOME__/.local/bin/claude-statusline subagent-statusline"
  }
}
