#!/usr/bin/env -S uv run --no-config --no-project --python 3.15 python
"""配布物内では自身のroot、個人binでは保持版を復旧できる安定したrootからhookを起動する。"""

import json
import os
import shutil
import subprocess
import sys
import tempfile
from pathlib import Path

_PLUGIN_ID = "agent-toolkit@ak110-dotfiles"
_CACHE_RELATIVE = Path("plugins/cache/ak110-dotfiles/agent-toolkit")
_COPY_IGNORE = shutil.ignore_patterns(
    ".hypothesis",
    ".mypy_cache",
    ".pytest_cache",
    ".ruff_cache",
    ".venv",
    "__pycache__",
)


def _installed_root() -> Path:
    """既存の名前だけのhook定義に対し、導入済みのCodex pluginを解決する。"""
    try:
        result = subprocess.run(
            ["codex", "plugin", "list", "--json"],
            capture_output=True,
            text=True,
            encoding="utf-8",
            errors="replace",
            timeout=15,
            check=False,
        )
    except (OSError, subprocess.TimeoutExpired) as error:
        raise ValueError(f"Codex導入情報の取得失敗: {error}。codex plugin list --jsonを確認する") from error
    if result.returncode != 0:
        raise ValueError(f"Codex plugin一覧を取得できません: {result.stderr}。codex plugin list --jsonを確認する")
    try:
        installed = json.loads(result.stdout)["installed"]
    except (json.JSONDecodeError, KeyError, TypeError) as error:
        raise ValueError("Codexの導入情報が不正。codex plugin list --jsonを確認する") from error
    if not isinstance(installed, list) or any(not isinstance(item, dict) for item in installed):
        raise ValueError("Codexのinstalled一覧の形式が不正。codex plugin list --jsonを確認する")
    matches = [item for item in installed if item.get("pluginId") == _PLUGIN_ID]
    if len(matches) != 1 or matches[0].get("enabled") is not True:
        raise ValueError("Codexのagent-toolkitが有効ではありません。codex plugin list --jsonを確認する")
    item = matches[0]
    for field in ("marketplaceName", "name", "version"):
        value = item.get(field)
        if (
            not isinstance(value, str) or not value or value in {".", ".."}
            or any(character in value for character in '/\\:\x00') or value.strip() != value
        ):
            raise ValueError(f"Codexの導入情報の{field}が欠落または不正。codex plugin list --jsonを確認する")
    if item["name"] != "agent-toolkit":
        raise ValueError("Codexの導入情報のnameとpluginIdが一致しない。codex plugin list --jsonを確認する")
    root = (
        Path(os.environ.get("CODEX_HOME") or Path.home() / ".codex")
        / "plugins"
        / "cache"
        / item["marketplaceName"]
        / item["name"]
        / item["version"]
    )
    if not (root / "agent_toolkit/hook.py").is_file():
        raise ValueError(f"Codexのhook実体が無い: {root}。codex plugin list --jsonで導入状態を確認し再導入する")
    return root


def _plugin_version(root: Path) -> str | None:
    """配布物のmanifestからversionを返す。"""
    for relative in (Path(".codex-plugin/plugin.json"), Path(".claude-plugin/plugin.json")):
        try:
            value = json.loads((root / relative).read_text(encoding="utf-8"))
        except OSError, json.JSONDecodeError:
            continue
        version = value.get("version") if isinstance(value, dict) else None
        if isinstance(version, str):
            return version
    return None


def _usable_root(root: Path, *, version: str | None = None) -> bool:
    """hookを起動でき、必要ならversionが一致する配布物かを返す。"""
    if not (root / "agent_toolkit/hook.py").is_file():
        return False
    if not ((root / "scripts/launch.py").is_file() or (root / "pyproject.toml").is_file()):
        return False
    return version is None or _plugin_version(root) == version


def _claude_cache_root(version: str) -> Path:
    return Path.home() / ".claude" / _CACHE_RELATIVE / version


def select_claude_plugin(installed: object, plugin_id: str, project: Path) -> Path:
    """公開plugin listの候補から、実効projectとscopeが一致する有効rootを返す。

    単独複製されるshimでも使えるよう、選別は標準ライブラリだけで完結させる。
    package側もこの関数を使い、互換hookと資料配送の選別条件を共有する。
    """
    if not isinstance(installed, list) or any(not isinstance(item, dict) for item in installed):
        raise ValueError("Claude Codeの導入情報の形式が不正: claude plugin list --jsonを確認する")
    project = project.resolve()
    priorities = {"user": 0, "project": 1, "local": 2}
    candidates = []
    for item in installed:
        if item.get("id") != plugin_id:
            continue
        scope = item.get("scope")
        if not isinstance(scope, str):
            raise ValueError(f"Claude Codeの{plugin_id}のscopeが不正: claude plugin list --jsonを確認する")
        if scope not in priorities:
            continue
        if scope != "user":
            owner = item.get("projectPath")
            if not isinstance(owner, str) or Path(owner).resolve() != project:
                continue
        candidates.append(item)
    if not candidates:
        raise ValueError(
            f"Claude Codeの{plugin_id}に適用される導入情報が無い: project={project}。"
            "claude plugin list --jsonで導入scopeを確認する"
        )
    priority = max(priorities[item["scope"]] for item in candidates)
    selected = [item for item in candidates if priorities[item["scope"]] == priority]
    if len(selected) != 1:
        raise ValueError(
            f"Claude Codeの{plugin_id}の実効候補が一意でない: {len(selected)}件 project={project}。"
            "claude plugin list --jsonで同じscopeの重複を確認する"
        )
    item = selected[0]
    if item.get("enabled") is not True:
        raise ValueError(f"Claude Codeの{plugin_id}は無効: claude plugin list --jsonで有効設定を確認する")
    path = item.get("installPath")
    if not isinstance(path, str) or not Path(path).is_absolute():
        raise ValueError(f"Claude Codeの{plugin_id}のinstallPathが不正: claude plugin list --jsonを確認する")
    root = Path(path).resolve()
    if not root.is_dir() or not (root / "skills").is_dir():
        raise ValueError(
            f"Claude Codeの{plugin_id}の実体またはskillsが無い: {root}。"
            "claude plugin list --jsonで導入scopeを確認し、同じscopeへ再導入する"
        )
    return root


def _current_claude_root() -> Path | None:
    """実行projectの公開導入情報から互換hook用の配布物を返す。"""
    try:
        result = subprocess.run(
            ["claude", "plugin", "list", "--json"],
            capture_output=True,
            encoding="utf-8",
            errors="replace",
            timeout=15,
            check=False,
        )
    except FileNotFoundError:
        return None
    except (OSError, subprocess.TimeoutExpired) as error:
        raise ValueError(f"Claude Codeの導入情報の取得失敗: {error}。claude plugin list --jsonを確認する") from error
    if result.returncode:
        raise ValueError(f"Claude Codeの導入情報の取得失敗: 終了コード{result.returncode}。claude plugin list --jsonを確認する")
    try:
        installed = json.loads(result.stdout)
    except json.JSONDecodeError as error:
        raise ValueError("Claude Codeの導入情報のJSONが不正。claude plugin list --jsonを確認する") from error
    if (
        isinstance(installed, list)
        and all(isinstance(item, dict) for item in installed)
        and not any(item.get("id") == _PLUGIN_ID for item in installed)
    ):
        return None
    root = select_claude_plugin(installed, _PLUGIN_ID, Path.cwd())
    if not _usable_root(root):
        raise ValueError(
            f"Claude Codeのhook実体が無い: {root}。"
            "claude plugin list --jsonで導入scopeを確認し、同じscopeへ再導入する"
        )
    return root


def _expected_codex_root(root: Path) -> bool:
    """復旧先がagent-toolkitのCodex cache直下かを返す。"""
    expected_parent = Path(os.environ.get("CODEX_HOME") or Path.home() / ".codex") / _CACHE_RELATIVE
    return root.parent.resolve(strict=False) == expected_parent.resolve(strict=False) and root.name not in {"", ".", ".."}


def _restore_from_claude_cache(root: Path) -> Path | None:
    """同版のClaude Code cacheを欠落したCodex cacheへ原子的に復旧する。"""
    if not _expected_codex_root(root):
        return None
    source = _claude_cache_root(root.name)
    if not _usable_root(source, version=root.name):
        return None
    root.parent.mkdir(parents=True, exist_ok=True)
    temporary = Path(tempfile.mkdtemp(prefix=f".{root.name}-restore-", dir=root.parent))
    staged = temporary / root.name
    try:
        shutil.copytree(source, staged, symlinks=True, ignore=_COPY_IGNORE)
        if _usable_root(root, version=root.name):
            return root
        if root.exists() or root.is_symlink():
            return None
        staged.replace(root)
        return root if _usable_root(root, version=root.name) else None
    except OSError:
        return root if _usable_root(root, version=root.name) else None
    finally:
        shutil.rmtree(temporary, ignore_errors=True)


def _external_root() -> Path:
    """個人binから、保持版または独立した配布cacheを解決する。"""
    pinned_value = os.environ.get("PLUGIN_ROOT")
    if pinned_value:
        pinned = Path(pinned_value)
        if _usable_root(pinned) or _restore_from_claude_cache(pinned) is not None:
            return pinned
    if (claude := _current_claude_root()) is not None:
        return claude
    return _installed_root()


def main() -> int:
    """配布内の直接呼出しと、プラグイン外へ複製した互換呼出しの配置を区別する。"""
    antigravity = len(sys.argv) == 3 and sys.argv[1] == "antigravity"
    if len(sys.argv) != 2 and not antigravity:
        print("usage: atk-hook EVENT | atk-hook antigravity EVENT", file=sys.stderr)
        print("次の操作: hook定義の起動コマンドへホスト形式とイベント名を渡す", file=sys.stderr)
        return 2
    source = Path(__file__).resolve()
    try:
        bundled = source.parent.name == "scripts"
        root = source.parent.parent if bundled else _external_root()
        launcher = root / "scripts" / "launch.py"
        # プラグイン外の旧呼出し用shimは、更新失敗・延期中の導入済み旧版も起動する。
        # 新しい配布内の直接呼出しは、この互換の起動方法を使わず自身のlaunch.pyを必須とする。
        if not bundled and not launcher.is_file() and (root / "agent_toolkit/hook.py").is_file():
            return subprocess.call(
                [
                    "uv",
                    "run",
                    "--project",
                    str(root),
                    "--locked",
                    "--no-default-groups",
                    str(root / "agent_toolkit/hook.py"),
                    *sys.argv[1:],
                ]
            )
        if not launcher.is_file():
            raise ValueError(f"hookの起動スクリプトがありません: {launcher}")
        os.execv(sys.executable, [sys.executable, str(launcher), "agent_toolkit/hook.py", *sys.argv[1:]])
    except (OSError, KeyError, TypeError, ValueError, AttributeError, subprocess.TimeoutExpired) as error:
        print(f"hookを起動できません: {error}", file=sys.stderr)
        print(
            "次の操作: 上記の原因側の導入情報または配布物の起動スクリプトを復旧し、同じhookを再実行する",
            file=sys.stderr,
        )
        return 1
    return 1


if __name__ == "__main__":
    raise SystemExit(main())
