#!/usr/bin/env bash
set -euo pipefail
SELF="$(readlink -f "${BASH_SOURCE[0]}")"
SCRIPT_DIR="$(cd "$(dirname "${SELF}")/.." && pwd)"
SCRIPT="${SCRIPT_DIR}/agent_toolkit/atk.py"

exec uv run --no-cache --no-config --no-project --python 3.15 python "${SCRIPT_DIR}/scripts/launch.py" --prepare-if-missing "${SCRIPT}" "$@"
