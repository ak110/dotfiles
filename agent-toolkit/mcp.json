{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "pyfltr": {
      "type": "stdio",
      "command": "uvx",
      "args": [
        "--from",
        "pyfltr>=3.22.0",
        "--exclude-newer-package",
        "pyfltr=false",
        "pyfltr",
        "mcp"
      ]
    },
    "agents_server": {
      "type": "stdio",
      "command": "uv",
      "args": [
        "run",
        "--no-config",
        "--no-project",
        "--python",
        "3.15",
        "python",
        "${PLUGIN_ROOT}/scripts/launch.py",
        "agent_toolkit/agents_server_mcp.py"
      ]
    }
  }
}
