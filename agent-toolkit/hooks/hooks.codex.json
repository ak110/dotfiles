{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "uv run --no-config --no-project --python 3.15 python \"${PLUGIN_ROOT}/scripts/launch.py\" agent_toolkit/hook.py rules_context_codex",
            "additionalContextLimit": 0
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "uv run --no-config --no-project --python 3.15 python \"${PLUGIN_ROOT}/scripts/launch.py\" agent_toolkit/hook.py rules_context_codex",
            "additionalContextLimit": 0
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|Edit|Write|mcp__agents_server__start|mcp__agents_server__send_message|mcp__agents_server__kill|mcp__agents_server__list|mcp__agents_server__show|mcp__pyfltr__run",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --no-config --no-project --python 3.15 python \"${PLUGIN_ROOT}/scripts/launch.py\" agent_toolkit/hook.py pretooluse"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|Edit|Write|mcp__agents_server__start|mcp__agents_server__send_message|mcp__agents_server__kill|mcp__agents_server__stop|mcp__agents_server__list|mcp__agents_server__show",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --no-config --no-project --python 3.15 python \"${PLUGIN_ROOT}/scripts/launch.py\" agent_toolkit/hook.py posttooluse"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "uv run --no-config --no-project --python 3.15 python \"${PLUGIN_ROOT}/scripts/launch.py\" agent_toolkit/hook.py stop"
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --no-config --no-project --python 3.15 python \"${PLUGIN_ROOT}/scripts/launch.py\" agent_toolkit/hook.py permissionrequest_codex"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "uv run --no-config --no-project --python 3.15 python \"${PLUGIN_ROOT}/scripts/launch.py\" agent_toolkit/hook.py user_prompt_submit"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "uv run --no-config --no-project --python 3.15 python \"${PLUGIN_ROOT}/scripts/launch.py\" agent_toolkit/hook.py subagent_stop_advisor"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "uv run --no-config --no-project --python 3.15 python \"${PLUGIN_ROOT}/scripts/launch.py\" agent_toolkit/hook.py session_end_cleanup",
            "timeout": 3
          }
        ]
      }
    ],
    "Interrupt": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "uv run --no-config --no-project --python 3.15 python \"${PLUGIN_ROOT}/scripts/launch.py\" agent_toolkit/hook.py session_activity"
          }
        ]
      }
    ]
  }
}
