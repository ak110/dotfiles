{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --no-project --script ${CLAUDE_PLUGIN_ROOT}/scripts/hook.py pretooluse"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|Bash|Skill|Read|Agent|Task|mcp__plugin_agent-toolkit_agents_server__start|mcp__plugin_agent-toolkit_agents_server__start_explore|mcp__plugin_agent-toolkit_agents_server__start_shell|mcp__plugin_agent-toolkit_agents_server__wait|mcp__plugin_agent-toolkit_agents_server__send_message|mcp__plugin_agent-toolkit_agents_server__kill|mcp__plugin_agent-toolkit_pyfltr__run_for_agent",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --no-project --script ${CLAUDE_PLUGIN_ROOT}/scripts/hook.py posttooluse"
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "Agent|Task",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --no-project --script ${CLAUDE_PLUGIN_ROOT}/scripts/hook.py posttooluse"
          }
        ]
      }
    ],
    "PermissionDenied": [
      {
        "matcher": "Agent|Task",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --no-project --script ${CLAUDE_PLUGIN_ROOT}/scripts/hook.py posttooluse"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "uv run --no-project --script ${CLAUDE_PLUGIN_ROOT}/scripts/hook.py autonomous_exit"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "uv run --no-project --script ${CLAUDE_PLUGIN_ROOT}/scripts/hook.py plan_save_advisor"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "uv run --no-project --script ${CLAUDE_PLUGIN_ROOT}/scripts/hook.py agents_server_session_advisor"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "uv run --no-project --script ${CLAUDE_PLUGIN_ROOT}/scripts/hook.py subagent_stop_advisor"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "uv run --no-project --script ${CLAUDE_PLUGIN_ROOT}/scripts/hook.py session_end_cleanup"
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "uv run --no-project --script ${CLAUDE_PLUGIN_ROOT}/scripts/hook.py stopfailure_notifier"
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --no-project --script ${CLAUDE_PLUGIN_ROOT}/scripts/hook.py permissionrequest"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --no-project --script ${CLAUDE_PLUGIN_ROOT}/scripts/hook.py permissionrequest_codex"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "uv run --no-project --script ${CLAUDE_PLUGIN_ROOT}/scripts/hook.py user_prompt_submit"
          }
        ]
      }
    ]
  }
}
