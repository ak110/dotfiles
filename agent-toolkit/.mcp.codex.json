{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "pyfltr": {
      "type": "stdio",
      "command": "uvx",
      "args": [
        "--from",
        "pyfltr>=3.22.0",
        "--exclude-newer-package",
        "pyfltr=false",
        "pyfltr",
        "mcp"
      ],
      "env_vars": [
        "http_proxy",
        "https_proxy",
        "no_proxy",
        "all_proxy",
        "HTTP_PROXY",
        "HTTPS_PROXY",
        "NO_PROXY",
        "ALL_PROXY",
        "GLOBAL_AGENT_HTTP_PROXY",
        "GLOBAL_AGENT_HTTPS_PROXY",
        "GLOBAL_AGENT_NO_PROXY",
        "HOME",
        "USERPROFILE",
        "LOCALAPPDATA",
        "APPDATA",
        "XDG_STATE_HOME",
        "XDG_CONFIG_HOME",
        "XDG_DATA_HOME",
        "XDG_CACHE_HOME",
        "AGENT_TOOLKIT_PRIVATE_NOTES",
        "CLAUDE_CONFIG_DIR",
        "CODEX_HOME",
        "AGENT_TOOLKIT_CONFIG_CLAUDE_HIGH_TIER_MODEL",
        "AGENT_TOOLKIT_CONFIG_CLAUDE_MEDIUM_TIER_MODEL",
        "AGENT_TOOLKIT_CONFIG_CLAUDE_LOW_TIER_MODEL",
        "AGENT_TOOLKIT_CONFIG_CODEX_HIGH_TIER_MODEL",
        "AGENT_TOOLKIT_CONFIG_CODEX_MEDIUM_TIER_MODEL",
        "AGENT_TOOLKIT_CONFIG_CODEX_LOW_TIER_MODEL",
        "AGENT_TOOLKIT_CONFIG_BASE_ENGINE",
        "AGENT_TOOLKIT_CONFIG_REVIEW_ENGINE",
        "AGENT_TOOLKIT_CONFIG_CHORES_ENGINE",
        "AGENT_TOOLKIT_CONFIG_ORCHESTRATE_ENGINE",
        "AGENT_TOOLKIT_CONFIG_WRITE_MODEL",
        "AGENT_TOOLKIT_CONFIG_CODEX_FAST_MODE",
        "AGENT_TOOLKIT_CONFIG_CODEX_MODEL_PROVIDERS",
        "AGENT_TOOLKIT_CONFIG_PROCESS_LOOP_REPOSITORIES",
        "AGENT_TOOLKIT_CONFIG_HIGH_TIER_MODEL",
        "AGENT_TOOLKIT_CONFIG_MEDIUM_TIER_MODEL",
        "AGENT_TOOLKIT_CONFIG_LOW_TIER_MODEL",
        "AGENT_TOOLKIT_CONFIG_ORCHESTRATE_MODEL"
      ]
    },
    "agents_server": {
      "type": "stdio",
      "command": "uv",
      "args": [
        "run",
        "--project",
        ".",
        "--locked",
        "--no-default-groups",
        "agent_toolkit/agents_server_mcp.py"
      ],
      "cwd": "./",
      "env_vars": [
        "http_proxy",
        "https_proxy",
        "no_proxy",
        "all_proxy",
        "HTTP_PROXY",
        "HTTPS_PROXY",
        "NO_PROXY",
        "ALL_PROXY",
        "GLOBAL_AGENT_HTTP_PROXY",
        "GLOBAL_AGENT_HTTPS_PROXY",
        "GLOBAL_AGENT_NO_PROXY",
        "HOME",
        "USERPROFILE",
        "LOCALAPPDATA",
        "APPDATA",
        "XDG_STATE_HOME",
        "XDG_CONFIG_HOME",
        "XDG_DATA_HOME",
        "XDG_CACHE_HOME",
        "AGENT_TOOLKIT_PRIVATE_NOTES",
        "CLAUDE_CONFIG_DIR",
        "CODEX_HOME",
        "AGENT_TOOLKIT_CONFIG_CLAUDE_HIGH_TIER_MODEL",
        "AGENT_TOOLKIT_CONFIG_CLAUDE_MEDIUM_TIER_MODEL",
        "AGENT_TOOLKIT_CONFIG_CLAUDE_LOW_TIER_MODEL",
        "AGENT_TOOLKIT_CONFIG_CODEX_HIGH_TIER_MODEL",
        "AGENT_TOOLKIT_CONFIG_CODEX_MEDIUM_TIER_MODEL",
        "AGENT_TOOLKIT_CONFIG_CODEX_LOW_TIER_MODEL",
        "AGENT_TOOLKIT_CONFIG_BASE_ENGINE",
        "AGENT_TOOLKIT_CONFIG_REVIEW_ENGINE",
        "AGENT_TOOLKIT_CONFIG_CHORES_ENGINE",
        "AGENT_TOOLKIT_CONFIG_ORCHESTRATE_ENGINE",
        "AGENT_TOOLKIT_CONFIG_WRITE_MODEL",
        "AGENT_TOOLKIT_CONFIG_CODEX_FAST_MODE",
        "AGENT_TOOLKIT_CONFIG_CODEX_MODEL_PROVIDERS",
        "AGENT_TOOLKIT_CONFIG_PROCESS_LOOP_REPOSITORIES",
        "AGENT_TOOLKIT_CONFIG_HIGH_TIER_MODEL",
        "AGENT_TOOLKIT_CONFIG_MEDIUM_TIER_MODEL",
        "AGENT_TOOLKIT_CONFIG_LOW_TIER_MODEL",
        "AGENT_TOOLKIT_CONFIG_ORCHESTRATE_MODEL"
      ]
    }
  }
}
