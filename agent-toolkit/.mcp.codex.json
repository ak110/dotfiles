{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "pyfltr": {
      "type": "stdio",
      "command": "uvx",
      "args": [
        "--from",
        "pyfltr>=3.22.0",
        "--exclude-newer-package",
        "pyfltr=false",
        "pyfltr",
        "mcp"
      ],
      "env_vars": [
        "http_proxy",
        "https_proxy",
        "no_proxy",
        "all_proxy",
        "HTTP_PROXY",
        "HTTPS_PROXY",
        "NO_PROXY",
        "ALL_PROXY",
        "GLOBAL_AGENT_HTTP_PROXY",
        "GLOBAL_AGENT_HTTPS_PROXY",
        "GLOBAL_AGENT_NO_PROXY"
      ]
    },
    "agents_server": {
      "type": "stdio",
      "command": "uv",
      "args": [
        "run",
        "--project",
        ".",
        "--locked",
        "--no-default-groups",
        "agent_toolkit/agents_server_mcp.py"
      ],
      "cwd": "./",
      "env_vars": [
        "http_proxy",
        "https_proxy",
        "no_proxy",
        "all_proxy",
        "HTTP_PROXY",
        "HTTPS_PROXY",
        "NO_PROXY",
        "ALL_PROXY",
        "GLOBAL_AGENT_HTTP_PROXY",
        "GLOBAL_AGENT_HTTPS_PROXY",
        "GLOBAL_AGENT_NO_PROXY"
      ]
    }
  }
}
