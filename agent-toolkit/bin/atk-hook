#!/usr/bin/env python3
"""導入済みCodex pluginの現行版からhookを起動する。"""

import json
import os
import subprocess
import sys
from pathlib import Path


_PLUGIN_ID = "agent-toolkit@ak110-dotfiles"
_NEXT_ACTION_PREFIX = "次の操作: "
"""次の操作の行の標識。plugin環境の外で動くため、`agent_toolkit/_common/next_action.py`と同じ値を持つ。"""


class _HookLaunchError(Exception):
    """hookを起動できない理由と次の操作。"""

    def __init__(self, reason: str, next_action: str) -> None:
        super().__init__(reason)
        self.reason = reason
        self.next_action = next_action


def main() -> int:
    """plugin一覧を正本としてhookへ引数と入出力を引き継ぐ。"""
    if len(sys.argv) != 2:
        print("usage: atk-hook EVENT", file=sys.stderr)
        print(f"{_NEXT_ACTION_PREFIX}hook定義の起動コマンドへイベント名を1つだけ渡す", file=sys.stderr)
        return 2
    try:
        result = subprocess.run(["codex", "plugin", "list", "--json"], capture_output=True, text=True, check=False)
    except OSError as error:
        print(f"Codex CLIを起動できません: {error}", file=sys.stderr)
        print(f"{_NEXT_ACTION_PREFIX}`codex`コマンドをPATHから起動できる状態にしてから、Codexを再起動する", file=sys.stderr)
        return 1
    if result.returncode != 0:
        print(result.stderr or "Codex plugin一覧を取得できません", file=sys.stderr)
        print(f"{_NEXT_ACTION_PREFIX}`codex plugin list --json`が成功することを確かめ、Codexの導入を直す", file=sys.stderr)
        return 1
    try:
        installed = json.loads(result.stdout)["installed"]
        matches = [item for item in installed if item.get("pluginId") == _PLUGIN_ID]
        if len(matches) != 1 or matches[0].get("enabled") is not True:
            raise _HookLaunchError(
                "agent-toolkitが有効ではありません",
                f"`codex plugin add {_PLUGIN_ID}`で導入し、Codexの設定でpluginを有効にしてからCodexを再起動する",
            )
        item = matches[0]
        plugin_root = (
            Path(os.environ.get("CODEX_HOME", Path.home() / ".codex"))
            / "plugins" / "cache" / item["marketplaceName"] / item["name"] / item["version"]
        )
        hook = plugin_root / "agent_toolkit" / "hook.py"
        if not hook.is_file():
            raise _HookLaunchError(
                f"Codex hook実体がありません: {hook}",
                f"`codex plugin remove {_PLUGIN_ID}`の後に`codex plugin add {_PLUGIN_ID}`で再導入し、Codexを再起動する",
            )
    except _HookLaunchError as error:
        print(error.reason, file=sys.stderr)
        print(f"{_NEXT_ACTION_PREFIX}{error.next_action}", file=sys.stderr)
        return 1
    except (KeyError, TypeError, ValueError, json.JSONDecodeError) as error:
        print(f"Codex plugin一覧を解釈できません: {error}", file=sys.stderr)
        print(f"{_NEXT_ACTION_PREFIX}`codex plugin list --json`の出力を確かめ、Codexを更新してから再起動する", file=sys.stderr)
        return 1
    return subprocess.call(
        ["uv", "run", "--project", str(plugin_root), "--locked", "--no-default-groups", str(hook), sys.argv[1]]
    )


if __name__ == "__main__":
    raise SystemExit(main())
