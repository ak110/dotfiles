#!/usr/bin/env bash
set -euo pipefail
SELF="$(readlink -f "${BASH_SOURCE[0]}")"
SCRIPT_DIR="$(cd "$(dirname "${SELF}")/.." && pwd)"
SCRIPT="${SCRIPT_DIR}/agent_toolkit/atk.py"

# 常駐サブコマンド以外は従来どおり実体へ置き換えて起動する。
# `process-loop`配下のサブコマンド（`abort`など）は常駐処理を開始しないため、第3引数が
# 空であるかオプションである場合だけ監督ループへ入る。
if [ "${2:-}" != "process-loop" ] || { [ "${1:-}" != "wi" ] && [ "${1:-}" != "mq" ]; } ||
    { [ -n "${3:-}" ] && [ "${3#-}" = "${3}" ]; }; then
    exec uv run --project "${SCRIPT_DIR}" --locked --no-default-groups "${SCRIPT}" "$@"
fi

# 常駐サブコマンドは自己更新のたびに再起動する。実体側で`uv`へ置き換えると
# 置き換え前の`uv`が子の終了を待って残り、再起動のたびにプロセス階層が1段深くなる。
# 実体は次の起動対象を受け渡しファイルへ書いて専用の終了コードで終了し、
# 本スクリプトが同一プロセスで次の実体を起動する。`uv run`を毎回経由するため、
# 更新後のplugin rootが持つlockfileと依存宣言を解決し直す。
# 停止シグナルは、プロセスグループ全体へ届く経路（端末のCtrl-C、systemdのcgroup単位の停止）で送る。
# 本スクリプトのPIDだけへシグナルを送った場合、本スクリプトは実体の終了を待たずに終了して
# 受け渡しファイルを削除し、実体は監督者を失ったまま動作を継続する。
SPEC="$(mktemp)"
trap 'rm -f "${SPEC}"' EXIT
LOG="$(uv run --project "${SCRIPT_DIR}" --locked --no-default-groups "${SCRIPT_DIR}/agent_toolkit/_atk/wi/process_loop_log.py")"
mkdir -p "$(dirname "${LOG}")"
received_signal="none"
log_launcher() {
    if ! printf '%s event=launcher_%s pid=%s status=%s signal=%s\n' \
        "$(date '+%Y-%m-%dT%H:%M:%S')" "$1" "$$" "$2" "${received_signal}" >>"${LOG}"; then
        printf 'process-loop監督ログへ記録できません: %s\n' "${LOG}" >&2
    fi
}
finish_launcher() {
    status=$?
    log_launcher exit "${status}"
    rm -f "${SPEC}"
}
trap finish_launcher EXIT
trap 'received_signal=HUP; exit 129' HUP
trap 'received_signal=INT; exit 130' INT
trap 'received_signal=TERM; exit 143' TERM
export AGENT_TOOLKIT_RESTART_SPEC="${SPEC}"
args=("$@")
while :; do
    : >"${SPEC}"
    status=0
    SCRIPT_DIR="$(cd "$(dirname "${SCRIPT}")/.." && pwd)"
    uv run --project "${SCRIPT_DIR}" --locked --no-default-groups "${SCRIPT}" "${args[@]}" || status=$?
    log_launcher child_end "${status}"
    if [ "${status}" -ne 75 ]; then
        exit "${status}"
    fi
    # `mapfile`はbash 4.0以降の組み込みのため、macOS既定のbash 3.2でも動く読み取りにする。
    next=()
    while IFS= read -r line; do
        next+=("${line}")
    done <"${SPEC}"
    # 先頭要素は次に起動するスクリプトパスであり、空の場合は再起動先を決められない。
    if [ "${#next[@]}" -lt 1 ] || [ -z "${next[0]}" ]; then
        log_launcher restart_spec_missing "${status}"
        exit "${status}"
    fi
    log_launcher restart "${status}"
    SCRIPT="${next[0]}"
    args=("${next[@]:1}")
done
