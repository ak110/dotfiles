{
  "mcpServers": {
    "pyfltr": {
      "command": "uvx",
      "args": ["--from", "pyfltr>=3.17.8", "pyfltr", "mcp"]
    },
    "agents_server": {
      "command": "uv",
      "args": [
        "run",
        "--no-project",
        "--script",
        "${CLAUDE_PLUGIN_ROOT}/scripts/agents_server_mcp.py"
      ]
    }
  }
}
