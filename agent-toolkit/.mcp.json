{
  "mcpServers": {
    "pyfltr": {
      "command": "uvx",
      "args": ["--from", "pyfltr>=3.17.8", "pyfltr", "mcp"]
    },
    "agents_server": {
      "command": "uv",
      "args": [
        "run",
        "--project",
        "${CLAUDE_PLUGIN_ROOT}",
        "--locked",
        "--no-default-groups",
        "${CLAUDE_PLUGIN_ROOT}/agent_toolkit/agents_server_mcp.py"
      ]
    }
  }
}
