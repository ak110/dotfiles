{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "pyfltr": {
      "type": "stdio",
      "command": "uvx",
      "args": [
        "--from",
        "pyfltr>=3.17.8",
        "pyfltr",
        "mcp"
      ]
    },
    "agents_server": {
      "type": "stdio",
      "command": "uv",
      "args": [
        "run",
        "--project",
        "${PLUGIN_ROOT}",
        "--locked",
        "--no-default-groups",
        "${PLUGIN_ROOT}/agent_toolkit/agents_server_mcp.py"
      ]
    }
  }
}
